# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carecompanion:carecompanion@localhost:5432/carecompanion

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_64_chars_long_for_production_use
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars_long_for_production_use
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In production same-origin; set only if running API and client on different origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Web Push / VAPID ─────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@carecompanion.app

# ─── SMTP (optional – leave blank to log emails instead) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareCompanion <no-reply@carecompanion.app>

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Misc ─────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
INVITE_CODE_EXPIRY_HOURS=24
MISSED_DOSE_GRACE_MINUTES=120
LOG_LEVEL=info
