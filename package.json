{
  "name": "carecompanion",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "test": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "seed": "npm run seed --workspace=server",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "setup": "npm install --legacy-peer-deps && npm run generate --workspace=server"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "prettier": "3.2.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "date-fns": "2.30.0"
  }
}
